<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nativeAdView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/gnt_corners_shape">

    <LinearLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/adMedia"
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="3dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnColab"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@null"
                android:src="@drawable/mi_chevron_down" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/middle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorBgNativeColab"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:id="@+id/adAppIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:round="4dp"
                tools:srcCompat="@tools:sample/avatars" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/adAppIcon"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/AppTheme.Ads"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ads_icon_rec"
                        android:paddingTop="2dp"
                        android:paddingEnd="4dp" />

                    <TextView
                        android:id="@+id/adHeadline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:lines="1"
                        android:textColor="@color/colorTxtHeading"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Stay up to date with your Ads" />
                </LinearLayout>

                <TextView
                    android:id="@+id/adBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingVertical="2dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/colorTxtBody"
                    android:textSize="12sp"
                    android:visibility="visible"
                    tools:text="Stay up to date with your Ads Check how your ads are Stay up to date with your" />

                <com.tomo.monetization.widget.AdsFlashButton
                    android:id="@+id/adCallToAction"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/cta_button_bg"
                    android:gravity="center"
                    android:lines="1"
                    android:textColor="@color/colorTxtCta"
                    android:textStyle="bold"
                    android:visibility="visible"
                    app:afb_cornerRadius="24dp" />
            </LinearLayout>

            <com.tomo.monetization.widget.AdsFlashButton
                android:id="@+id/adCallToActionC"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/cta_button_bg"
                android:gravity="center"
                android:lines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/colorTxtCta"
                android:textStyle="bold"
                android:visibility="gone"
                app:afb_cornerRadius="24dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
